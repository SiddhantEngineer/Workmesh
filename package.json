{
  "name": "workmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-First Ticket Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace=@workmesh/api",
    "web:dev": "npm run dev --workspace=@workmesh/web",
    "build:api": "npm run build --workspace=@workmesh/api",
    "build:web": "npm run build --workspace=@workmesh/web",
    "build": "npm run build:api && npm run build:web",
    "start:api": "npm run start --workspace=@workmesh/api",
    "start:web": "npm run start --workspace=@workmesh/web",
    "db:generate": "npm run db:generate --workspace=@workmesh/db",
    "db:migrate": "npm run db:migrate --workspace=@workmesh/db",
    "db:studio": "npm run db:studio --workspace=@workmesh/db",
    "mcp:dev": "npm run dev --workspace=@workmesh/mcp-server",
    "mcp:build": "npm run build --workspace=@workmesh/mcp-server",
    "mcp:start": "npm run start --workspace=@workmesh/mcp-server"
  }
}
